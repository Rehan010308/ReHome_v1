# Supabase (browser) — never put the service-role key here
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set on the Edge Function `analyze-item`, not in Vite
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Optional: Google Maps Embed. This is a BROWSER key and is visible to anyone
# who loads the page — that is expected. Restrict it by HTTP referrer in the
# Google Cloud console. Never put a secret or server key here.
VITE_GOOGLE_MAPS_API_KEY=
